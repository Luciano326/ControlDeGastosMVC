@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mb-4">
    <h1 class="display-5">Bienvenido al Sistema de Control de Gastos</h1>
    <p class="lead">Accedé rápidamente a las funciones principales del sistema</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-3 mb-4">
        <div class="card shadow-sm h-100 text-center">
            <div class="card-body">
                <i class="fas fa-plus-circle fa-2x mb-3 text-primary"></i>
                <h5 class="card-title">Registrar Gasto</h5>
                <p class="card-text">Agregá un nuevo gasto fácilmente.</p>
                <a asp-controller="Gastos" asp-action="Create" class="btn btn-outline-primary" alt="Ir a gastos">Nuevo gasto</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card shadow-sm h-100 text-center">
            <div class="card-body">
                <i class="fas fa-list fa-2x mb-3 text-success"></i>
                <h5 class="card-title">Historial</h5>
                <p class="card-text">Revisá todos los gastos registrados.</p>
                <a asp-controller="Gastos" asp-action="Index" class="btn btn-outline-success">Ver</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card shadow-sm h-100 text-center">
            <div class="card-body">
                <i class="fas fa-chart-line fa-2x mb-3 text-info"></i>
                <h5 class="card-title">Reportes</h5>
                <p class="card-text">Visualizá resúmenes mensuales y totales.</p>
                <a asp-controller="Gastos" asp-action="Estadisticas" class="btn btn-outline-info">Reportes</a>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card shadow-sm h-100 text-center">
            <div class="card-body">
                <i class="fas fa-file-pdf fa-2x mb-3 text-danger"></i>
                <h5 class="card-title">Exportar PDF/EXCEL</h5>
                <p class="card-text">Generá reportes descargables.</p>
                <a asp-controller="Gastos" asp-action="Index" class="btn btn-outline-danger">Exportar</a>
            </div>
        </div>
    </div>
</div>
