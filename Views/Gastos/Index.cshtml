@model IEnumerable<ControlDeGastosMVC.API.Models.Gasto>

@{
    ViewData["Title"] = "Index";
}

<h1>Control de Gastos</h1>
<hr/>   
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
    <div class="btn-group" role="group" aria-label="Acciones">
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Registrar Gasto
        </a>
        <a asp-action="Estadisticas" class="btn btn-outline-primary">
            <i class="bi bi-bar-chart me-1"></i> Ver Estadísticas
        </a>
        <a asp-action="ExportarPdf" class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i>PDF
        </a>
        <a asp-action="ExportarExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i>Excel
        </a>
    </div>
    <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-2 mb-3">
        <input type="number" name="mes" class="form-control w-auto"
               placeholder="Mes" min="1" max="12"
               value="@ViewBag.Mes" />

        <input type="number" name="anio" class="form-control w-auto"
               placeholder="Año" min="2000" max="2100"
               value="@ViewBag.Anio" />

        <input type="text" name="searchString" class="form-control w-auto"
               placeholder="Buscar descripción o categoría"
               value="@ViewBag.SearchString" />

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search me-1"></i> Buscar
        </button>

        <a href="@Url.Action("Index", "Gastos")" class="btn btn-outline-secondary">
                <i class="bi bi-eraser-fill"></i>
         </a>
    </form>
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered">
        <thead class="thead-dark">
            <tr>
                <th class="text-center">@Html.DisplayName("Descripción")</th>
                <th class="text-center">@Html.DisplayNameFor(model => model.First().Monto)</th>
                <th class="text-center">@Html.DisplayNameFor(model => model.First().Categoria)</th>
                <th class="text-center">@Html.DisplayNameFor(model => model.First().Fecha)</th>
                <th class="text-center">@Html.DisplayName("Fecha Creación")</th>
                <th class="text-center">@Html.DisplayName("Acciones")</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">@Html.DisplayFor(modelItem => item.Descripcion)</td>
                    <td class="text-center">$@Html.DisplayFor(modelItem => item.Monto)</td>
                    <td class="text-center">@Html.DisplayFor(modelItem => item.Categoria)</td>
                    <td class="text-center">@Html.DisplayFor(modelItem => item.Fecha)</td>
                    <td class="text-center">@Html.DisplayFor(modelItem => item.FechaCreacion)</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Editar</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-warning">Detalles</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (ViewBag.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                <a class="btn btn-outline-primary mx-1 @(i == ViewBag.CurrentPage ? "active" : "")"
                        href="@Url.Action("Index", new {
                    page = i,
                    searchString = ViewBag.SearchString,
                    mes = ViewBag.Mes,
                    anio = ViewBag.Anio
                    })">
                    @i
                </a>
                }
            </ul>
        </nav>
    }

}
else
{
    <div class="card">
        <div class="card-body text-center">
            No hay registros de gastos.
        </div>
    </div>
}


