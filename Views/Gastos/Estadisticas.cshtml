@model ControlDeGastosMVC.API.ViewModels.EstadisticaGastosViewModel
@{
    ViewData["Title"] = "Estadísticas de gastos";
    var categoriasJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model.Categorias);
    var montosJson = Newtonsoft.Json.JsonConvert.SerializeObject(Model.Montos);
}

<h1>Estadísticas</h1>
<hr />
<div class="d-flex flex-wrap align-items-center justify-content-end mb-0">
    <form asp-action="Estadisticas" method="get" class="d-flex mt-6 mt-md-0" role="search">
        <input type="number" name="mes" class="form-control m-0 mb-md-1 mx-2 w-auto"
               placeholder="Mes" min="1" max="12"
               value="@ViewBag.Mes" />

        <input type="number" name="anio" class="form-control m-0 mb-md-1 mx-2 w-auto"
               placeholder="Año" min="2000" max="2100"
               value="@ViewBag.Anio" />


        <button type="submit" class="btn btn-primary m-0 mb-md-1 w-auto" >
            <i class="bi bi-search me-1"></i>Buscar
        </button>
        
        <a asp-action="Estadisticas" class="btn btn-outline-secondary mx-2 m-0 mb-md-1 w-auto">
            Limpiar
            <i class="bi bi-eraser-fill"></i>
        </a>
    </form>
</div>

<hr />

<div class="container mb-4">
    <div class="row text-center">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total gastado</h6>
                    <h4 class="text-success">$@Model.TotalGastado.ToString("N2")</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted">Categoría con más gasto</h6>
                    <h5>@Model.CategoriaTop</h5>
                </div>
            </div>  
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title text-muted">Cantidad de gastos</h6>
                    <h5>@Model.CantidadGastos</h5>
                </div>
            </div>
        </div>
    </div>
</div>

<hr />
<br />
<div class="container">
    <div class="row mb-4 justify-content-lg-between">
        <div class="card shadow-sm w-75 justify-content-between">
            <h3 class="text-center">Gráfico de barras</h3>
            <div style="height: 400px;">
                <canvas id="graficoBarras"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row mb-4 justify-content-end">
        <div class="card shadow-sm mt-2 w-75">
            <h3 class="text-center">Gráfico de torta</h3>
            <div style="height: 400px;">
                <canvas id="graficoTorta"></canvas>
            </div>
        </div>
    </div>
</div>

<hr />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const categorias = @Html.Raw(categoriasJson);
    const montos = @Html.Raw(montosJson);

    // Gráfico de barras
    const ctxBar = document.getElementById('graficoBarras');
    new Chart(ctxBar, {
        type: 'bar',
        data: {
            labels: categorias,
            datasets: [{
                label: 'Total gastado ($)',
                data: montos,
                backgroundColor: [
                    '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b', '#858796', '#ff36cc',
                ]
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });

    // Gráfico de torta
    const ctxTorta = document.getElementById('graficoTorta');
    new Chart(ctxTorta, {
        type: 'doughnut',
        data: {
            labels: categorias,
            datasets: [{
                label: 'Total gastado ($)',
                data: montos,
                backgroundColor: [
                    '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b', '#858796', '#ff36cc',
                ],
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });
</script>

