@{
    ViewData["Title"] = "Verificar código";
    var email = ViewBag.Email as string;
}

<div class="d-flex justify-content-center align-items-center mt-5">
    <div class="col-md-6">
        <div class="card shadow p-4 rounded">
            <h2>Verificar código</h2>
            <hr />
            <form asp-action="VerificarToken" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="email" value="@email" />

                <div class="form-group">
                    <label for="token">Código recibido</label>
                    <input type="text" name="token" class="form-control" required />
                </div>

                <br />
                <button type="submit" class="btn btn-primary">Verificar</button>
                <a asp-controller="Login" asp-action="Login" class="btn btn-secondary">Cancelar</a>
            </form>
            <div class="mt-3">
                <strong>Este código expirará en: <span id="timer">02:00</span></strong>
            </div>
        </div>
    </div>
</div>


<script>
    let duration = 120;
    const timerElement = document.getElementById("timer");

    const countdown = setInterval(() => {
        const minutes = Math.floor(duration / 60);
        const seconds = duration % 60;
        timerElement.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        duration--;

        if (duration < 0) {
            clearInterval(countdown);
            timerElement.textContent = "Expirado";
            document.querySelector("form button[type='submit']").disabled = true;
        }
    }, 1000);
</script>