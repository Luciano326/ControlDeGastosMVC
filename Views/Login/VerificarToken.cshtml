@{
    ViewData["Title"] = "Verificar código";
    var email = ViewBag.Email as string;
}

<div class="d-flex justify-content-center align-items-center mt-5">
    <div class="col-md-6">
        <div class="card shadow p-4 rounded">
            <h2>Verificar código</h2>
            <hr />
            <form asp-action="VerificarToken" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="email" value="@email" />

                <div class="form-group">
                    <label for="token">Código recibido</label>
                    <input type="text" name="token" class="form-control" required />
                </div>

                <br />
                <button type="submit" class="btn btn-primary">Verificar</button>
                <a asp-controller="Login" asp-action="Login" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
